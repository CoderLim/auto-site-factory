  {
    "id": "sitemap-toolify",
    "sourceType": "sitemap",
    "name": "Toolify Sitemap",
    "scope": "ai-tools",
    "enabled": false,
    "config": {
      "sourceRole": "discovery",
      "sitemapUrl": "https://www.toolify.ai/sitemap.xml",
      "baselineOnFirstRun": true,
      "fetchPageMetadata": true,
      "maxSitemaps": 30,
      "maxUrls": 20000,
      "maxNewUrls": 50,
