  {
    "id": "hf-new-models",
    "sourceType": "official_api",
    "name": "Hugging Face New Models",
    "scope": "ai",
    "enabled": true,
    "config": {
      "sourceRole": "discovery",
      "url": "https://huggingface.co/api/models?sort=createdAt&direction=-1&limit=100",
      "idField": "id",
      "nameFields": ["id"],
      "nameTransform": "basename",
      "publishedAtField": "createdAt",
      "entityType": "AI_MODEL",
      "cursorOverlapMinutes": 15
    }
